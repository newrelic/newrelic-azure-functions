{
  "branches": [
    "master",
    { "name": "develop", "prerelease": true }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "docs/CHANGELOG.md"
    }],
    ["@semantic-release/npm", {
      "npmPublish": false
    }],
    ["semantic-release-plugin-update-version-in-files", {
      "files": [
        "LogForwarder/index.js",
        "armTemplates/azuredeploy-eventhubforwarder.json",
        "armTemplates/azuredeploy-blobforwarder.json",
        "bicep/azuredeploy-eventhubforwarder.bicep"
      ],
      "placeholder": "0.0.0-development"
    }],
    ["@semantic-release/git", {
      "assets": [
        "docs/CHANGELOG.md",
        "package.json",
        "package-lock.json",
        "armTemplates/azuredeploy-eventhubforwarder.json",
        "armTemplates/azuredeploy-blobforwarder.json",
        "bicep/azuredeploy-eventhubforwarder.bicep"
      ]
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "npm run package:logforwarder",
      "publishCmd": "bash scripts/publish-release.sh ${nextRelease.version}"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "LogForwarder/index.js", "name": "index-LogForwarder-${nextRelease.gitTag}.js", "label": "LogForwarder Azure Function"},
        {"path": "LogForwarder.zip", "label": "LogForwarder Azure ZipDeploy package (version ${nextRelease.gitTag})"}
      ]
    }]
  ]
}
